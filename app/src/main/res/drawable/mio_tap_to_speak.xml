<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#805A6BE8"
                android:endColor="#704E5AD7"/>
            <stroke android:width="1dp" android:color="#70FFFFFF"/>
            <corners android:radius="40dp"/>
            <padding
                android:left="30dp"
                android:top="13dp"
                android:right="30dp"
                android:bottom="13dp"/>
        </shape>
    </item>

    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#5A4E6FD8"
                android:endColor="#554A55C8"/>
            <stroke android:width="1dp" android:color="#45FFFFFF"/>
            <corners android:radius="40dp"/>
            <padding
                android:left="30dp"
                android:top="13dp"
                android:right="30dp"
                android:bottom="13dp"/>
        </shape>
    </item>
</selector>
