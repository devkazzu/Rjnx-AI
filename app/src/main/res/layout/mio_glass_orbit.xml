<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mio_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/mio_glass_circle"
                android:src="@drawable/ic_mio_settings"
                android:tint="#EAF0FF"
                android:contentDescription="Settings" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/btn_help_center"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/mio_glass_circle"
                android:src="@drawable/ic_mio_help"
                android:tint="#EAF0FF"
                android:contentDescription="Help Center" />
        </LinearLayout>

        <com.rjnx.MioGreetingTextView
            android:id="@+id/mio_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#E8ECFF"
            android:textSize="21sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Raju 👋"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mio is here for you"
            android:textColor="#B9C0DE"
            android:textSize="17sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp">

            <com.rjnx.MioOrbView
                android:id="@+id/mio_orb_view"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/mio_orb_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Mio"
                android:textColor="#FFFFFFFF"
                android:textSize="43sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/btn_tap_to_speak"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/mio_tap_to_speak"
            android:gravity="center"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            android:text="🎙  Tap to speak"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Six feature buttons -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="3"
            android:rowCount="2"
            android:useDefaultMargins="false">

            <LinearLayout
                android:id="@+id/action_voice"
                style="@style/MioFeatureCell"
                android:layout_column="0"
                android:layout_row="0">
                <ImageView style="@style/MioFeatureIcon" android:src="@drawable/ic_mic_white" />
                <TextView style="@style/MioFeatureLabel" android:text="Voice" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_vision"
                style="@style/MioFeatureCell"
                android:layout_column="1"
                android:layout_row="0">
                <ImageView style="@style/MioFeatureIcon" android:src="@drawable/ic_mio_vision" />
                <TextView style="@style/MioFeatureLabel" android:text="Vision" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_translate"
                style="@style/MioFeatureCell"
                android:layout_column="2"
                android:layout_row="0">
                <ImageView style="@style/MioFeatureIcon" android:src="@drawable/ic_mio_translate" />
                <TextView style="@style/MioFeatureLabel" android:text="Translate" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_chat"
                style="@style/MioFeatureCell"
                android:layout_column="0"
                android:layout_row="1">
                <ImageView style="@style/MioFeatureIcon" android:src="@drawable/ic_mio_chat" />
                <TextView style="@style/MioFeatureLabel" android:text="AI Chat" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_youtube"
                style="@style/MioFeatureCell"
                android:layout_column="1"
                android:layout_row="1">
                <ImageView style="@style/MioFeatureIcon" android:src="@drawable/ic_mio_youtube" />
                <TextView style="@style/MioFeatureLabel" android:text="YouTube" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/action_camera"
                style="@style/MioFeatureCell"
                android:layout_column="2"
                android:layout_row="1">
                <ImageView style="@style/MioFeatureIcon" android:src="@drawable/ic_mio_camera" />
                <TextView style="@style/MioFeatureLabel" android:text="Camera" />
            </LinearLayout>
        </GridLayout>

        <!-- Quick Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/mio_glass_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Quick Actions"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <LinearLayout style="@style/MioQuickRow">
                <ImageView style="@style/MioQuickIcon" android:src="@drawable/ic_mio_quick_summary" />
                <TextView style="@style/MioQuickText" android:text="Summarize Screen" />
                <TextView style="@style/MioArrow" android:text="›" />
            </LinearLayout>

            <LinearLayout style="@style/MioQuickRow">
                <ImageView style="@style/MioQuickIcon" android:src="@drawable/ic_mio_quick_solve" />
                <TextView style="@style/MioQuickText" android:text="Solve Anything" />
                <TextView style="@style/MioArrow" android:text="›" />
            </LinearLayout>

            <LinearLayout style="@style/MioQuickRow">
                <ImageView style="@style/MioQuickIcon" android:src="@drawable/ic_mio_quick_code" />
                <TextView style="@style/MioQuickText" android:text="Help me Code" />
                <TextView style="@style/MioArrow" android:text="›" />
            </LinearLayout>

            <LinearLayout style="@style/MioQuickRow">
                <ImageView style="@style/MioQuickIcon" android:src="@drawable/ic_mio_quick_story" />
                <TextView style="@style/MioQuickText" android:text="Tell me a Story" />
                <TextView style="@style/MioArrow" android:text="›" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/mio_glass_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout style="@style/MioNavCellSelected" android:id="@+id/nav_home">
                <ImageView style="@style/MioNavIcon" android:src="@drawable/ic_mio_home" />
                <TextView style="@style/MioNavText" android:text="Home" />
            </LinearLayout>

            <LinearLayout style="@style/MioNavCell" android:id="@+id/nav_chats">
                <ImageView style="@style/MioNavIcon" android:src="@drawable/ic_mio_chat" />
                <TextView style="@style/MioNavText" android:text="Chats" />
            </LinearLayout>

            <LinearLayout style="@style/MioNavCell" android:id="@+id/nav_tools">
                <ImageView style="@style/MioNavIcon" android:src="@drawable/ic_mio_tools" />
                <TextView style="@style/MioNavText" android:text="Tools" />
            </LinearLayout>

            <LinearLayout style="@style/MioNavCell" android:id="@+id/nav_settings">
                <ImageView style="@style/MioNavIcon" android:src="@drawable/ic_mio_settings" />
                <TextView style="@style/MioNavText" android:text="Settings" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
