<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mio_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Top-right controls: Settings + Help Center -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">

            <ImageButton
                android:id="@+id/btn_settings"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/mio_glass_circle"
                android:src="@drawable/ic_mio_settings"
                android:tint="#EAF0FF"
                android:contentDescription="Settings"
                android:clickable="true"
                android:focusable="true" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <ImageButton
                android:id="@+id/btn_help_center"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/mio_glass_circle"
                android:src="@drawable/ic_mio_help"
                android:tint="#EAF0FF"
                android:contentDescription="Help Center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Dynamic greeting -->
        <com.rjnx.MioGreetingTextView
            android:id="@+id/mio_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#E8ECFF"
            android:textSize="21sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Raju 👋"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mio is here for you"
            android:textColor="#B9C0DE"
            android:textSize="17sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="8dp">

            <View
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:background="@drawable/mio_orb" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Mio"
                android:textColor="#FFFFFF"
                android:textSize="43sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/btn_tap_to_speak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/mio_glass_button"
            android:paddingStart="30dp"
            android:paddingTop="13dp"
            android:paddingEnd="30dp"
            android:paddingBottom="13dp"
            android:text="🎙  Tap to speak"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:columnCount="3"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <TextView android:id="@+id/action_voice" style="@style/MioFeature" android:text="🎙&#10;Voice" />
            <TextView android:id="@+id/action_vision" style="@style/MioFeature" android:text="◉&#10;Vision" />
            <TextView android:id="@+id/action_translate" style="@style/MioFeature" android:text="文&#10;Translate" />
            <TextView android:id="@+id/action_chat" style="@style/MioFeature" android:text="💬&#10;AI Chat" />
            <TextView android:id="@+id/action_youtube" style="@style/MioFeature" android:text="▶&#10;YouTube" />
            <TextView android:id="@+id/action_camera" style="@style/MioFeature" android:text="▣&#10;Camera" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/mio_glass_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="8dp" />

            <TextView
                android:id="@+id/quick_summarize"
                style="@style/MioQuickAction"
                android:text="▣   Summarize Screen                              ›" />

            <TextView
                android:id="@+id/quick_solve"
                style="@style/MioQuickAction"
                android:text="✦   Solve Anything                                ›" />

            <TextView
                android:id="@+id/quick_code"
                style="@style/MioQuickAction"
                android:text="&lt;/&gt;  Help me Code                                  ›" />

            <TextView
                android:id="@+id/quick_story"
                style="@style/MioQuickAction"
                android:text="📖   Tell me a Story                               ›" />
        </LinearLayout>

        <!-- Bottom navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/mio_glass_card"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nav_home"
                style="@style/MioNavItem"
                android:text="⌂&#10;Home" />

            <TextView
                android:id="@+id/nav_chats"
                style="@style/MioNavItem"
                android:text="◌&#10;Chats" />

            <TextView
                android:id="@+id/nav_tools"
                style="@style/MioNavItem"
                android:text="✣&#10;Tools" />

            <TextView
                android:id="@+id/nav_settings"
                style="@style/MioNavItem"
                android:text="⚙&#10;Settings" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
